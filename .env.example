# Copy to .env for local development. Never commit .env.
# On Render, set these as Environment Variables in the dashboard instead.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True only on your own machine. Leave unset (False) in production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nepobackend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://nepowebapp.netlify.app
CSRF_TRUSTED_ORIGINS=https://nepobackend.onrender.com

# Supabase (media storage). The service key is a full-access secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=nepo-media

# Optional: point Django at Supabase Postgres instead of sqlite
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
