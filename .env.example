# Copy to .env for local development. Never commit .env.
# On Render, set these as Environment Variables in the dashboard instead.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True only on your own machine. Leave unset (False) in production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nepobackend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://nepowebapp.netlify.app
# Regexes, comma-separated. Default allows localhost on any port (Flutter web dev).
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:\d+$,^http://127\.0\.0\.1:\d+$
CSRF_TRUSTED_ORIGINS=https://nepobackend.onrender.com

# Supabase (media storage). SUPABASE_SERVICE_KEY must be the service_role key (or an
# sb_secret_ key), NOT the anon/publishable key: Supabase refuses uploads made with
# public keys. It is a full-access secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=nepo-media

# Database. Required in production (on Render: the database's Internal Database URL),
# e.g. postgresql://USER:PASSWORD@HOST/DBNAME. Leave empty locally (with
# DJANGO_DEBUG=True) to use a SQLite file instead. Never commit a real value.
DATABASE_URL=
