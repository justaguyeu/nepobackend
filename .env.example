DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string-see-readme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase (used for media storage; can also host the Postgres DB)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_MEDIA_BUCKET=nepo-media

# Optional: point Django at Supabase Postgres instead of sqlite
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
